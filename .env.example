# Naukri credentials (required)
USERNAME=your_naukri_email@example.com
PASSWORD=your_naukri_password

# AI scoring (required for apply_agent.py)
# Option A: OpenAI direct
# OPEN_API_KEY=sk-...

# Option B: OpenRouter (run.sh maps OPENROUTER_API_KEY -> OPEN_API_KEY)
OPENROUTER_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1/chat/completions
OPENAI_MODEL=google/gemini-2.5-flash-lite

# Pipeline Controls
USE_ADVANCED_CONFIG=1
MIN_APPLY_SCORE=70
NAUKRI_DAILY_QUOTA=50

# Salary Floor Controls (applies to all roles)
MIN_SALARY_LPA=20
ALLOW_UNDISCLOSED_SALARY=0

# Optional Residential Proxy (if running on cloud or VPN)
# HTTP_PROXY=http://auto:YOUR_TOKEN@proxy.apify.com:8000
# HTTPS_PROXY=http://auto:YOUR_TOKEN@proxy.apify.com:8000
